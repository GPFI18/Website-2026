# Resend — transactional email for the four site forms.
# Create a key at https://resend.com/api-keys and verify the sending domain.
RESEND_API_KEY=

# Address that form submissions are delivered to.
CONTACT_TO_EMAIL=info@globalpeaceforisrael.com

# Verified sender on your Resend domain (e.g. website@globalpeaceforisrael.com)
CONTACT_FROM_EMAIL=

# Canonical site URL, used for metadata, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://globalpeaceforisrael.com
